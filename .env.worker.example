# Worker connects to the same DB as Vercel does. Point at the Turso URL in
# production, or the same file: URL as .env.local when running locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local LLM endpoint on this machine. Ollama default shown.
LLM_PROVIDER=ollama
LLM_PROVIDER_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# Optional provider chain. Leave empty to keep the single-provider behavior above.
# Recommended weekend mode:
# - Claude Code first, then Codex, then local Ollama fallback.
# - Keep Ollama running; it is the fallback after CLI quota/budget/auth failures.
TRANSLATION_PROVIDER_CHAIN=
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_TIMEOUT_MS=120000
CLAUDE_CODE_MAX_BUDGET_USD=
CLAUDE_CODE_BARE=false
CLAUDE_CODE_CONCURRENCY=1

CODEX_CLI_ENABLED=false
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_MS=120000
CODEX_CLI_ALLOW_BYPASS=false
CODEX_CLI_CONCURRENCY=1

# Requeue failed rows after the pending queue drains. Permanent errors such as
# auth/model/quota failures stay failed instead of looping.
WORKER_REQUEUE_FAILED_WHEN_IDLE=false
WORKER_FAILED_RETRY_LIMIT=2
WORKER_FAILED_RETRY_BATCH_SIZE=500

# Poll interval in ms. Lower = faster pickup, more Turso read traffic.
WORKER_POLL_INTERVAL_MS=2000

# Max parallel translations this worker handles. Keep ≤ your LLM's capacity.
WORKER_CONCURRENCY=2
