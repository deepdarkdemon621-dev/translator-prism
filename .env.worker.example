# Worker connects to the same DB as Vercel does. Point at the Turso URL in
# production, or the same file: URL as .env.local when running locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Keep one explicitly approved CLI provider per production run. Do not append
# ollama or another implicit fallback: a provider failure should be visible.
# To use Codex instead, set this to codex, enable CODEX_CLI_ENABLED below, and
# disable CLAUDE_CODE_ENABLED.
TRANSLATION_PROVIDER_CHAIN=claude-code
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_TIMEOUT_MS=120000
# Chapter batches extend the base timeout by this many ms per extra item.
CLAUDE_CODE_BATCH_ITEM_TIMEOUT_MS=10000
CLAUDE_CODE_MAX_BUDGET_USD=
# In non-bare mode, ANTHROPIC_API_KEY is stripped from the Claude subprocess
# so Claude Code can use the local subscription login.
CLAUDE_CODE_BARE=false
CLAUDE_CODE_CONCURRENCY=1
# e.g. FRI 18:00-SAT 09:30 (Claude quota resets every Sat 10:00 JST)
CLAUDE_CODE_ALLOWED_WEEKLY_WINDOW=
CLAUDE_CODE_WINDOW_TZ=Asia/Tokyo
# When true, Claude Code quota/rate-limit errors are retried during the
# allowed window instead of failing the current batch. Once the window closes,
# WORKER_CLAUDE_WINDOW_ONLY pauses new claims.
CLAUDE_CODE_EXCLUSIVE_WITHIN_WINDOW=false
CLAUDE_CODE_EXCLUSIVE_RETRY_DELAY_MS=60000

# When true, the worker only claims new rows while Claude Code is inside
# CLAUDE_CODE_ALLOWED_WEEKLY_WINDOW. Use with TRANSLATION_PROVIDER_CHAIN=claude-code
# to stop translation work after the window closes.
WORKER_CLAUDE_WINDOW_ONLY=false

CODEX_CLI_ENABLED=false
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_MS=120000
# Chapter batches extend the base timeout by this many ms per extra item.
CODEX_CLI_BATCH_ITEM_TIMEOUT_MS=10000
CODEX_CLI_ALLOW_BYPASS=false
CODEX_CLI_CONCURRENCY=1
# Passed to Codex as model_reasoning_effort and recorded in translation_runs.
CODEX_CLI_REASONING_EFFORT=

# Requeue failed rows after the pending queue drains. Permanent errors such as
# auth/model/quota failures stay failed instead of looping.
WORKER_REQUEUE_FAILED_WHEN_IDLE=false
WORKER_FAILED_RETRY_LIMIT=2
WORKER_FAILED_RETRY_BATCH_SIZE=500

# Poll interval in ms. Lower = faster pickup, more Turso read traffic.
WORKER_POLL_INTERVAL_MS=2000

# Max parallel translations this worker handles. Keep ≤ your LLM's capacity.
WORKER_CONCURRENCY=2

# Rows claimed per worker slot. Claude Code and Codex both support chapter
# batches; use >1 to reduce CLI calls. Batches never mix chapters/languages.
WORKER_BATCH_SIZE=1

# Optional per-batch source character budget. A claim stops adding rows once
# the running source length exceeds this (the first row always claims).
WORKER_BATCH_MAX_CHARS=

# Lease-based claiming: a processing row can be reclaimed only after its
# lease expires. Keep the lease comfortably longer than the batch CLI timeout;
# the heartbeat renews leases for in-flight rows.
WORKER_LEASE_MS=600000
WORKER_LEASE_HEARTBEAT_MS=60000
