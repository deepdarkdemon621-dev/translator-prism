# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.worker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project
data/
.env.local
.superpowers/
.claude/

# local test fixtures — large dict/epub files, snapshots
test-novel/

# secrets / keys — belt-and-suspenders on top of .env*
*.key
*.pem
*.p12
*.pfx
secrets/
**/credentials.json
**/service-account*.json

# local databases / caches
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# logs
*.log
logs/

# editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# build / tmp
tmp/
temp/
*.tmp


.vercel
